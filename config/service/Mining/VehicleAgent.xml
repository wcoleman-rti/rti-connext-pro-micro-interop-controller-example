<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd">

    <qos_library name="MiningDiscoveryQos">
        <qos_profile name="vehicle_discovery" base_name="MiningDiscoveryQos::common">
            <domain_participant_qos>
                <transport_builtin>
                    <mask>UDPv4</mask>
                    <udpv4>
                        <disable_auto_interface_config>true</disable_auto_interface_config>
                        <interface_table>
                            <element>
                                <address>127.0.0.1</address>
                                <interface_name>lo</interface_name>
                                <flags>UDP_INTERFACE_INTERFACE_UP_FLAG|UDP_INTERFACE_INTERFACE_MULTICAST_FLAG</flags>
                                <net_mask>255.255.255.1</net_mask>
                            </element>
                        </interface_table>
                    </udpv4>
                </transport_builtin>
                <discovery>
                    <initial_peers>
                        <element>239.255.0.1</element>
                    </initial_peers>
                    <enabled_transports>
                        <element>udpv4</element>
                    </enabled_transports>
                    <multicast_receive_addresses>
                        <element>udpv4://239.255.0.1</element>
                    </multicast_receive_addresses>
                </discovery>
                <discovery_config>
                    <builtin_discovery_plugins>SDP</builtin_discovery_plugins>
                </discovery_config>
            </domain_participant_qos>
        </qos_profile>
    </qos_library>

    <domain_participant_library name="VehicleAgentParticipants">
        <domain_participant name="vehicle_agent" domain_ref="MiningDomains::machine_comms">
            <domain_participant_qos base_name="MiningDiscoveryQos::vehicle_discovery"/>
            <publisher name="vehicle_publisher">
                <data_writer name="status_writer" topic_ref="machine_status">
                    <datawriter_qos base_name="MiningDataQos::status"/>
                </data_writer>
                <data_writer name="position_writer" topic_ref="machine_position">
                    <datawriter_qos base_name="MiningDataQos::position"/>
                </data_writer>
            </publisher>
            <subscriber name="vehicle_subscriber">
                <data_reader name="command_reader" topic_ref="machine_command">
                    <datareader_qos base_name="MiningDataQos::command"/>
                </data_reader>
            </subscriber>
        </domain_participant>
    </domain_participant_library>
</dds>