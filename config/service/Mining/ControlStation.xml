<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd">
    
    <qos_library name="MiningDiscoveryQos">
        <qos_profile name="control_discovery" base_name="MiningDiscoveryQos::common">
        </qos_profile>
    </qos_library>

    <domain_participant_library name="ControlStationParticipants">
        <domain_participant name="control_station" domain_ref="MiningDomains::machine_comms">
            <domain_participant_qos base_name="MiningDiscoveryQos::control_discovery"/>
            <publisher name="control_publisher">
                <data_writer name="command_writer" topic_ref="machine_command">
                    <datawriter_qos base_name="MiningDataQos::command"/>
                </data_writer>
            </publisher>
            <subscriber name="control_subscriber">
                <data_reader name="status_reader" topic_ref="machine_status">
                    <datareader_qos base_name="MiningDataQos::status"/>
                </data_reader>
                <data_reader name="position_reader" topic_ref="machine_position">
                    <datareader_qos base_name="MiningDataQos::position"/>
                </data_reader>
            </subscriber>
        </domain_participant>
    </domain_participant_library>
</dds>