<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd">
    
    <qos_library name="HpcSafetyDiscoveryQos">
        <qos_profile name="hpc" base_name="HpcSafetyDiscoveryQos::discovery_base">
            <domain_participant_qos>
                <discovery>
                    <initial_peers>
                        <element>udpv4://127.0.0.1</element>
                    </initial_peers>
                    <multicast_receive_addresses/>
                </discovery>
            </domain_participant_qos>
        </qos_profile>
        
        <qos_profile name="safety_controller" base_name="HpcSafetyDiscoveryQos::discovery_base">
            <domain_participant_qos>
                <transport_builtin>
                    <udpv4>
                        <disable_auto_interface_config>true</disable_auto_interface_config>
                        <interface_table>
                            <element>
                                <address>127.0.0.1</address>
                                <interface_name>lo</interface_name>
                                <flags>UDP_INTERFACE_INTERFACE_UP_FLAG|UDP_INTERFACE_INTERFACE_MULTICAST_FLAG</flags>
                                <net_mask>255.255.255.1</net_mask>
                            </element>
                        </interface_table>
                    </udpv4>
                </transport_builtin>
                <discovery>
                    <initial_peers>
                        <element>1@127.0.0.1</element>
                    </initial_peers>
                    <enabled_transports>
                        <element>udpv4</element>
                    </enabled_transports>
                    <multicast_receive_addresses/>
                </discovery>
            </domain_participant_qos>
        </qos_profile>
    </qos_library>
    
    <domain_library name="HpcSafetyDomains">
        <domain name="primary" domain_id="42">
            <register_type name="SafetyCommandType" type_ref="HpcSafety::SafetyCommand"/>
            <register_type name="HpcHealthType" type_ref="HpcSafety::HpcHealth"/>
            <register_type name="HpcTelemetryType" type_ref="HpcSafety::HpcTelemetry"/>
            <topic name="safety_command" register_type_ref="SafetyCommandType"/>
            <topic name="hpc_health" register_type_ref="HpcHealthType"/>
            <topic name="hpc_telemetry" register_type_ref="HpcTelemetryType"/>
        </domain>
    </domain_library>

    <domain_participant_library name="HpcSafetyParticipants">
        <domain_participant name="safety_controller" domain_ref="HpcSafetyDomains::primary">
            <domain_participant_qos base_name="HpcSafetyDiscoveryQos::safety_controller"/>
            <publisher name="safety_publisher">
                <data_writer name="command_writer" topic_ref="safety_command">
                    <datawriter_qos base_name="HpcSafetyPatternQos::safety_command"/>
                </data_writer>
            </publisher>
            <subscriber name="safety_subscriber">
                <data_reader name="health_reader" topic_ref="hpc_health">
                    <datareader_qos base_name="HpcSafetyPatternQos::hpc_health"/>
                </data_reader>
                <data_reader name="telemetry_reader" topic_ref="hpc_telemetry">
                    <datareader_qos base_name="HpcSafetyPatternQos::hpc_telemetry"/>
                </data_reader>
            </subscriber>
        </domain_participant>

        <domain_participant name="hpc_a" domain_ref="HpcSafetyDomains::primary">
            <domain_participant_qos base_name="HpcSafetyDiscoveryQos::hpc"/>
            <publisher name="hpc_publisher">
                <data_writer name="health_writer" topic_ref="hpc_health">
                    <datawriter_qos base_name="HpcSafetyPatternQos::hpc_health"/>
                </data_writer>
                <data_writer name="telemetry_writer" topic_ref="hpc_telemetry">
                    <datawriter_qos base_name="HpcSafetyPatternQos::hpc_telemetry"/>
                </data_writer>
            </publisher>
            <subscriber name="hpc_subscriber">
                <data_reader name="command_reader" topic_ref="safety_command">
                    <content_filter name="hpc_command_filter" kind="builtin.sql">
                        <expression>target_hpc_id = %0</expression>
                        <expression_parameters>
                            <element>0</element>
                        </expression_parameters>
                    </content_filter>
                    <datareader_qos base_name="HpcSafetyPatternQos::safety_command"/>
                </data_reader>
            </subscriber>
        </domain_participant>

        <domain_participant name="hpc_b" base_name="hpc_a"/>

    </domain_participant_library>
</dds>